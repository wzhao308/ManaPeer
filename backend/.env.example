# Copy this file to .env and fill in a real secret key before running the app.
#
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# This key encrypts your Canvas token (and later Gradescope/PrairieLearn
# credentials) at rest in the local database. Keep it secret; never commit
# your real .env file.
MANAPEER_SECRET_KEY=

# Path to the SQLite database file (created automatically on first run).
MANAPEER_DB_PATH=./manapeer.db

# Minutes between automatic background syncs.
MANAPEER_SYNC_INTERVAL_MINUTES=15

# Origin of the frontend dev server, for CORS.
MANAPEER_FRONTEND_ORIGIN=http://localhost:5173
